{
  "name": "budget-planner-web",
  "version": "0.1.0",
  "description": "Zero-based budgeting, CSV import, savings goals and debt payoff, powered by Rust/WASM",
  "scripts": {
    "build:wasm": "npm run build:wasm:core && npm run build:wasm:ocr && npm run build:wasm:pdf && npm run build:wasm:pdfrender && npm run build:wasm:llm && npm run build:wasm:glmocr-vision && npm run build:wasm:glmocr-embed && npm run build:wasm:glmocr-decoder && npm run build:wasm:glmocr-orchestrate",
    "build:wasm:core": "cd ../crates/budget-wasm && wasm-pack build --target web --out-dir ../../www/pkg",
    "build:wasm:ocr": "cd ../crates/budget-wasm-ocr && wasm-pack build --target web --out-dir ../../www/pkg-ocr",
    "build:wasm:pdf": "cd ../crates/budget-wasm-pdf && wasm-pack build --target web --out-dir ../../www/pkg-pdf",
    "build:wasm:pdfrender": "cd ../crates/budget-wasm-pdfrender && wasm-pack build --target web --out-dir ../../www/pkg-pdfrender",
    "build:wasm:llm": "cd ../crates/budget-wasm-llm && wasm-pack build --target web --out-dir ../../www/pkg-llm",
    "build:wasm:glmocr-vision": "cd ../crates/budget-wasm-glmocr-vision && wasm-pack build --target web --out-dir ../../www/pkg-glmocr-vision",
    "build:wasm:glmocr-embed": "cd ../crates/budget-wasm-glmocr-embed && wasm-pack build --target web --out-dir ../../www/pkg-glmocr-embed",
    "build:wasm:glmocr-decoder": "cd ../crates/budget-wasm-glmocr-decoder && wasm-pack build --target web --out-dir ../../www/pkg-glmocr-decoder",
    "build:wasm:glmocr-orchestrate": "cd ../crates/budget-wasm-glmocr-orchestrate && wasm-pack build --target web --out-dir ../../www/pkg-glmocr-orchestrate",
    "start": "npm run build:wasm && webpack serve --mode development",
    "build": "webpack --mode production",
    "deploy": "npm run build:wasm && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "style-loader": "^3.3.3",
    "vitest": "^4.1.11",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
